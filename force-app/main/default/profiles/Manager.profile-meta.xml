<?xml version="1.0" encoding="UTF-8"?>
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <custom>true</custom>
    <description>CPQ Manager profile. Can approve/reject quotes, view all quotes, manage team data, and read catalog information. Cannot manage products, add-ons, or resource roles.</description>
    <userLicense>Salesforce</userLicense>

    <!-- ==================== Application Visibility ==================== -->
    <applicationVisibilities>
        <application>Arya_G</application>
        <default>true</default>
        <visible>true</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>standard__Approvals</application>
        <default>false</default>
        <visible>true</visible>
    </applicationVisibilities>

